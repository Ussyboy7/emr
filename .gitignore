# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
backend/.venv/
ENV/
env.bak/
venv.bak/

# TypeScript incremental build info
*.tsbuildinfo

# Environment files (never commit real envs)
.env
.env.*
frontend/.env.*
!frontend/.env.*.example

# Celery beat schedule (runtime artifact)
backend/celerybeat-schedule*

# Archived development files
archive_development_files/

# Runtime output (bind-mounted into containers) — NEVER commit
backups/
logs/

# TLS material — private keys must NEVER be committed. Certs are usually fine
# but we default-ignore the whole ssl/ tree to be safe. Commit certs
# explicitly with `git add -f ssl/<name>.crt` if required.
ssl/
*.key
*.pem
!*.pub.pem

# Local-only PDF design previews (Phase 1 PDF house style)
_pdf_previews/

# User uploads and generated media (keep on server / volume, not in git)
backend/media/

# Auto-generated by Next.js (path varies between dev and build)
frontend/next-env.d.ts
