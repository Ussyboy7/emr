# Optional registry-based deploy (copy to registry.env on stag/prod servers).
# When EMR_USE_REGISTRY=1, deploy pulls pre-built images instead of building on the server.
#
#   cp backend/env/registry.env.example backend/env/registry.env
#   # edit image names / registry login as needed
#
# CI publishes to GHCR on push to main (see .github/workflows/ci-cd.yml).
# Manual deploy: docker login ghcr.io (PAT with read:packages) once per server.

EMR_USE_REGISTRY=1

# GHCR image names (lowercase org). Tag is set at deploy time from git SHA (or GITHUB_SHA in CI).
EMR_BACKEND_IMAGE=ghcr.io/ussyboy7/emr-backend
# Staging server:
EMR_FRONTEND_IMAGE=ghcr.io/ussyboy7/emr-frontend-stag
# Production server: use emr-frontend-prod instead of emr-frontend-stag

# Optional — deploy runs docker login when set (otherwise rely on cached `docker login ghcr.io`)
# EMR_REGISTRY_USER=github-username
# EMR_REGISTRY_TOKEN=ghp_...
